; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Orbit Architect"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://assets/art/generated/logo_mark.png"

[autoload]

EventBus="*res://autoload/event_bus.gd"
Art="*res://autoload/art.gd"
GameData="*res://autoload/game_data.gd"
GameState="*res://autoload/game_state.gd"
Localization="*res://autoload/localization.gd"
Audio="*res://autoload/audio.gd"
MCPRuntimeProbe="*uid://bsg12huaf1u5i"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_mcp/plugin.cfg")

[mcp_toolkit]

server/version="latest"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=0
rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"
