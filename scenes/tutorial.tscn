[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://ui/tutorial.gd" id="1_script"]
[ext_resource type="Theme" path="res://ui/theme.tres" id="2_theme"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_school"]
content_margin_left = 16.0
content_margin_top = 12.0
content_margin_right = 16.0
content_margin_bottom = 12.0
bg_color = Color(0.0352941, 0.054902, 0.0823529, 0.98)
